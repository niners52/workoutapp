{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "resourceClass": "m-medium",
        "appExtensions": [
          {
            "targetName": "WorkoutTrackerWatch",
            "bundleIdentifier": "com.tylerr82.workouttracker8052.watchkitapp"
          }
        ]
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "resourceClass": "m-medium",
        "appExtensions": [
          {
            "targetName": "WorkoutTrackerWatch",
            "bundleIdentifier": "com.tylerr82.workouttracker8052.watchkitapp"
          }
        ]
      }
    },
    "production": {
      "channel": "production",
      "ios": {
        "resourceClass": "m-medium",
        "buildConfiguration": "Release",
        "credentialsSource": "remote",
        "appExtensions": [
          {
            "targetName": "WorkoutTrackerWatch",
            "bundleIdentifier": "com.tylerr82.workouttracker8052.watchkitapp"
          }
        ]
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6758069018"
      }
    }
  }
