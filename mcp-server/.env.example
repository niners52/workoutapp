# Supabase project URL (Settings -> API). Same project the app points at.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Service role key (Settings -> API -> service_role). Server-side only; never ship in the app.
SUPABASE_SERVICE_ROLE_KEY=

# Long random hex string; the MCP endpoint is served at /<this value>. Generate with:
#   openssl rand -hex 32
MCP_SECRET_PATH=

# Optional. Only rows belonging to this auth.users id are served. Strongly
# recommended if anyone else (an accountability partner) has an account in the
# same Supabase project.
SUPABASE_USER_ID=

# Optional. IANA time zone used for week boundaries in get_weekly_volume so
# they line up with the phone. Default: UTC.
TIMEZONE=America/Denver

# Optional. Requests per minute per client IP on the MCP endpoint. Default 60.
RATE_LIMIT_PER_MINUTE=60

# Set by Railway automatically. Default 3000 locally.
PORT=3000
